# Runtime database connection. Use the Neon pooled endpoint (hostname contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# Direct Neon endpoint used only by Prisma migrations and controlled maintenance.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DB_NAME?sslmode=require"
RESTORE_DATABASE_URL="postgresql://USER:PASSWORD@DISPOSABLE_HOST:5432/co_build_restore_drill?sslmode=require"
CONFIRM_RESTORE_DRILL=""

# GitHub Actions repository secrets, not Vercel runtime variables. The nightly
# workflow requires the direct Neon URL and a unique passphrase of 32+ characters.
# DATABASE_DIRECT_URL
# BACKUP_ENCRYPTION_PASSPHRASE

# Explicit runtime boundary. Use demo only for showcase data and account switching.
APP_MODE="pilot"

# Managed authentication (required in pilot and production).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Public site URL used in generated links and emails.
NEXT_PUBLIC_APP_URL="https://your-co-build-domain.com"

# Real uploads are fail-closed. Create a Vercel Blob store with Private access,
# connect it to this project, then explicitly enable uploads after accepting the
# temporary unscanned-file risk or configuring a scanner.
REAL_UPLOADS_ENABLED="false"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace_me"
MAX_UPLOAD_BYTES="15728640"
ALLOW_UNSCANNED_UPLOADS="false"
MALWARE_SCANNER_URL="https://scanner.your-co-build-domain.com/scan"
MALWARE_SCANNER_TOKEN="replace-with-a-long-scanner-token"

# A pilot may temporarily accept unscanned files explicitly. Production remains
# blocked until the repository has a tested malware-scanning integration.

# Owner-accessible error monitoring connected to Vercel logs (Sentry or equivalent).
ERROR_MONITORING_PROJECT_URL="https://monitoring.example.com/co-build"
OPS_ALERT_WEBHOOK_URL="https://alerts.example.com/co-build-webhook"

# Company-account payment instructions shown to renter and host accounts.
COMPANY_PAYMENT_NAME="Co-Build Pte Ltd"
COMPANY_PAYMENT_UEN="202600000A"
COMPANY_PAYMENT_BANK="Your Bank Name"
COMPANY_PAYMENT_ACCOUNT="000-000-000-0"

# Owner-operated privacy, legal, backup, support, and incident controls.
DPO_CONTACT_EMAIL="privacy@your-co-build-domain.com"
SUPPORT_CONTACT_EMAIL="support@your-co-build-domain.com"
OPERATIONS_OWNER_EMAIL="ops@your-co-build-domain.com"
SECURITY_OWNER_EMAIL="security@your-co-build-domain.com"
BACKUP_OWNER_EMAIL="backup@your-co-build-domain.com"
CRON_SECRET="generate-a-long-random-secret"
LEGAL_REVIEW_APPROVED_VERSION=""
RESTORE_DRILL_COMPLETED_AT=""
UPTIME_MONITOR_URL="https://monitor.example.com/co-build"
INCIDENT_RESPONSE_URL="https://docs.example.com/co-build/incidents"
DATA_RETENTION_UPLOAD_DAYS="365"
DATA_RETENTION_ACCOUNT_DAYS="2555"
RETENTION_EXECUTION_ENABLED="false"

# Optional transactional email outbox delivery. Notices remain visible in-app
# when these values are absent; no email success is claimed until delivery is recorded.
RESEND_API_KEY="re_replace_me"
TRANSACTIONAL_EMAIL_FROM="Co-Build <notifications@your-co-build-domain.com>"
