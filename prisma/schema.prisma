generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum UserRole {
  RENTER
  HOST
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingStatus {
  DRAFT
  PENDING_ADMIN
  APPROVED
  REJECTED
  SUSPENDED
}

enum SpaceType {
  MAKER_BENCH
  SMALL_BAY
  MEDIUM_BAY
  LARGE_BAY
}

enum FactoryType {
  B1
  B2
  UNKNOWN
}

enum PowerType {
  SINGLE_PHASE
  THREE_PHASE
}

enum BookingStatus {
  DRAFT
  PENDING_HOST
  PENDING_ADMIN_HIGH_RISK
  APPROVED_FOR_PAYMENT
  PAYMENT_SUBMITTED
  PAID_CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  HOST_REJECTED
  ADMIN_REJECTED
  CANCELLED
}

enum RiskLevel {
  STANDARD
  ADMIN_APPROVAL
}

enum UploadType {
  VERIFICATION
  CHECK_IN
  CHECK_OUT
  LISTING_PHOTO
  FLOOR_PLAN
  PAYMENT_EVIDENCE
  DISPUTE_EVIDENCE
  CONTRACT
}

enum StorageProvider {
  LEGACY_LOCAL
  VERCEL_BLOB
}

enum UploadStatus {
  PENDING
  AVAILABLE
  REJECTED
  DELETED
  LEGACY_DEMO
}

enum ScanStatus {
  NOT_REQUIRED
  PENDING
  SAFE
  UNSAFE
  FAILED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  SUSPENDED
}

enum AdditionalRequirementStatus {
  PENDING_HOST
  APPROVED_FOR_PAYMENT
  PAYMENT_SUBMITTED
  PAID_CONFIRMED
  HOST_REJECTED
  CANCELLED
}

enum PaymentStatus {
  SUBMITTED
  VERIFIED
  REJECTED
  REFUNDED
}

enum PaymentKind {
  BOOKING_TOTAL
  SUBSCRIPTION
  ADDITIONAL_REQUIREMENT
  DEPOSIT_RELEASE
  REFUND
}

enum DepositStatus {
  HELD
  RELEASED
  PARTIALLY_RETAINED
  RETAINED
  DISPUTED
}

enum PrivacyRequestType {
  ACCESS
  CORRECTION
  DELETION
}

enum PrivacyRequestStatus {
  SUBMITTED
  IN_REVIEW
  COMPLETED
  REJECTED
}

enum PlatformSubscriptionStatus {
  UNPAID
  PENDING_ADMIN
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PlatformSubscriptionProvider {
  BANK_TRANSFER
  STRIPE
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum ModerationReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id                              String                     @id
  authProviderId                  String?                    @unique
  role                            UserRole
  fullName                        String
  mobile                          String
  email                           String                     @unique
  companyName                     String
  uen                             String?
  workType                        String?
  verificationStatus              VerificationStatus         @default(PENDING)
  platformSubscriptionStatus      PlatformSubscriptionStatus @default(UNPAID)
  platformSubscriptionProvider    PlatformSubscriptionProvider?
  platformSubscriptionReference   String?
  platformSubscriptionPaidAt      DateTime?
  platformSubscriptionPeriodStart DateTime?
  platformSubscriptionPeriodEnd   DateTime?
  platformSubscriptionNextBilling DateTime?
  stripeCustomerId                String?                    @unique
  stripeSubscriptionId            String?                    @unique
  suspended                       Boolean                    @default(false)
  bookings                        Booking[]
  sentMessages                    BookingMessage[]           @relation("MessageSender")
  renterConversations             Conversation[]             @relation("ConversationRenter")
  hostConversations               Conversation[]             @relation("ConversationHost")
  conversationMessages            ConversationMessage[]      @relation("ConversationMessageSender")
  hostListings                    Listing[]                  @relation("HostListings")
  additionalRequirements          AdditionalRequirement[]
  uploadsCreated                  Upload[]                   @relation("UploadCreator")
  uploadsOwned                    Upload[]                   @relation("UploadOwner")
  approvalEvents                  ApprovalEvent[]            @relation("ApprovalActor")
  exportEvents                    AdminExportEvent[]         @relation("ExportActor")
  agreementAcceptances            AgreementAcceptance[]
  submittedPayments               PaymentRecord[]            @relation("PaymentPayer")
  reviewedPayments                PaymentRecord[]            @relation("PaymentReviewer")
  privacyRequests                 PrivacyRequest[]
  notifications                  Notification[]
  moderationReportsCreated       ModerationReport[]         @relation("ModerationReporter")
  moderationReportsReceived      ModerationReport[]         @relation("ModerationReportedUser")
  moderationReportsReviewed      ModerationReport[]         @relation("ModerationReviewer")
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
}

model StripeWebhookEvent {
  id            String   @id
  type          String
  livemode      Boolean
  processedAt   DateTime @default(now())

  @@index([processedAt])
}

model Listing {
  id                 String             @id @default(cuid())
  slug               String             @unique
  title              String
  address            String
  location           String
  sizeSqft           Int
  spaceType          SpaceType
  factoryType        FactoryType
  status             ListingStatus      @default(PENDING_ADMIN)
  accessHours        String
  powerType          PowerType
  loadingAccessJson  String
  amenitiesJson      String
  permittedWorkJson  String
  prohibitedWorkJson String
  safetyRulesJson    String
  cancellationPolicy String
  photoUrlsJson      String
  floorPlanUrl       String
  priceDay           Int
  priceSevenDays     Int
  priceThirtyDays    Int
  priceSixtyDays     Int
  depositStandard    Int
  depositHighRisk    Int
  cleaningFee        Int
  fireSafety         String             @default("Fire extinguishers on site")
  electricalSupply   String             @default("Declared by host")
  hostId             String?
  host               User?              @relation("HostListings", fields: [hostId], references: [id])
  equipmentAddons    ListingEquipment[]
  bookings           Booking[]
  conversations      Conversation[]
  uploads            Upload[]
  approvalEvents     ApprovalEvent[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model EquipmentAddon {
  id              String             @id @default(cuid())
  slug            String             @unique
  name            String
  pricePerBooking Int
  category        String
  listings        ListingEquipment[]
  bookings        BookingAddon[]
}

model ListingEquipment {
  listingId        String
  equipmentAddonId String
  listing          Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  equipmentAddon   EquipmentAddon @relation(fields: [equipmentAddonId], references: [id], onDelete: Cascade)

  @@id([listingId, equipmentAddonId])
}

model Booking {
  id                     String                  @id @default(cuid())
  listingId              String
  userId                 String
  durationDays           Int
  startAt                DateTime?
  endAt                  DateTime?
  bookingTimeZone        String                  @default("Asia/Singapore")
  workType               String
  riskLevel              RiskLevel
  status                 BookingStatus           @default(PENDING_HOST)
  rentalTotal            Int
  deposit                Int
  cleaningFee            Int
  addonTotal             Int
  grandTotal             Int
  depositStatus          DepositStatus           @default(HELD)
  depositReturned        Int                     @default(0)
  depositRetained        Int                     @default(0)
  safetyAcceptedAt       DateTime?
  renterDealConfirmedAt  DateTime?
  hostDealConfirmedAt    DateTime?
  listing                Listing                 @relation(fields: [listingId], references: [id])
  user                   User                    @relation(fields: [userId], references: [id])
  addons                 BookingAddon[]
  uploads                Upload[]
  messages               BookingMessage[]
  approvalEvents         ApprovalEvent[]
  additionalRequirements AdditionalRequirement[]
  paymentRecords         PaymentRecord[]
  agreementAcceptances   AgreementAcceptance[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([listingId, startAt, endAt])
}

model AdditionalRequirement {
  id             String                      @id @default(cuid())
  bookingId      String
  userId         String
  detail         String
  status         AdditionalRequirementStatus @default(PENDING_HOST)
  quotedRate     Int                         @default(0)
  contractText   String?
  emailedTo      String?
  emailedAt      DateTime?
  paidAt         DateTime?
  booking        Booking                     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user           User                        @relation(fields: [userId], references: [id])
  paymentRecords PaymentRecord[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
}

model BookingMessage {
  id        String   @id @default(cuid())
  bookingId String
  senderId  String
  body      String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

model Conversation {
  id        String                @id @default(cuid())
  listingId String
  renterId  String
  hostId    String
  listing   Listing               @relation(fields: [listingId], references: [id], onDelete: Cascade)
  renter    User                  @relation("ConversationRenter", fields: [renterId], references: [id])
  host      User                  @relation("ConversationHost", fields: [hostId], references: [id])
  messages  ConversationMessage[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([listingId, renterId])
  @@index([renterId, updatedAt])
  @@index([hostId, updatedAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("ConversationMessageSender", fields: [senderId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model BookingAddon {
  bookingId        String
  equipmentAddonId String
  priceAtBooking   Int
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  equipmentAddon   EquipmentAddon @relation(fields: [equipmentAddonId], references: [id])

  @@id([bookingId, equipmentAddonId])
}

model Upload {
  id               String          @id @default(cuid())
  type             UploadType
  originalName     String
  storageProvider  StorageProvider @default(VERCEL_BLOB)
  objectKey        String?         @unique
  legacyLocalPath  String?
  contentType      String?
  sizeBytes        Int?
  checksumSha256   String?
  uploadStatus     UploadStatus    @default(PENDING)
  scanStatus       ScanStatus      @default(PENDING)
  uploadedByUserId String?
  ownerUserId      String?
  bookingId        String?
  listingId        String?
  uploadedByUser   User?           @relation("UploadCreator", fields: [uploadedByUserId], references: [id])
  ownerUser        User?           @relation("UploadOwner", fields: [ownerUserId], references: [id])
  booking          Booking?        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  listing          Listing?        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  paymentRecord    PaymentRecord?
  createdAt        DateTime        @default(now())
  verifiedAt       DateTime?
  deletedAt        DateTime?

  @@index([ownerUserId, createdAt])
  @@index([bookingId, type])
  @@index([listingId, type])
  @@index([uploadStatus, createdAt])
}

model ApprovalEvent {
  id        String           @id @default(cuid())
  actorId   String?
  listingId String?
  bookingId String?
  target    String
  decision  ApprovalDecision
  note      String
  actor     User?            @relation("ApprovalActor", fields: [actorId], references: [id])
  listing   Listing?         @relation(fields: [listingId], references: [id])
  booking   Booking?         @relation(fields: [bookingId], references: [id])
  createdAt DateTime         @default(now())
}

model AdminExportEvent {
  id         String   @id @default(cuid())
  actorId    String
  exportType String
  rowCount   Int
  actor      User     @relation("ExportActor", fields: [actorId], references: [id])
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
}

model PaymentRecord {
  id                      String                 @id @default(cuid())
  payerId                 String
  reviewerId              String?
  bookingId               String?
  additionalRequirementId String?
  proofUploadId           String?                @unique
  kind                    PaymentKind
  status                  PaymentStatus          @default(SUBMITTED)
  amount                  Int
  currency                String                 @default("SGD")
  reference               String
  idempotencyKey          String                 @unique
  reviewNote              String?
  isPilotTest             Boolean                @default(false)
  submittedAt             DateTime               @default(now())
  reviewedAt              DateTime?
  payer                   User                   @relation("PaymentPayer", fields: [payerId], references: [id])
  reviewer                User?                  @relation("PaymentReviewer", fields: [reviewerId], references: [id])
  booking                 Booking?               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  additionalRequirement   AdditionalRequirement? @relation(fields: [additionalRequirementId], references: [id], onDelete: Cascade)
  proofUpload             Upload?                @relation(fields: [proofUploadId], references: [id])

  @@index([bookingId, status, submittedAt])
  @@index([payerId, kind, status])
}

model AgreementAcceptance {
  id              String   @id @default(cuid())
  bookingId       String
  userId          String
  role            UserRole
  documentVersion String
  documentHash    String
  acceptedAt      DateTime @default(now())
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookingId, userId, documentVersion, documentHash])
  @@index([bookingId, documentHash])
}

model PrivacyRequest {
  id          String               @id @default(cuid())
  userId      String
  type        PrivacyRequestType
  status      PrivacyRequestStatus @default(SUBMITTED)
  detail      String
  resolution  String?
  createdAt   DateTime             @default(now())
  completedAt DateTime?
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model RateLimitBucket {
  id              String   @id @default(cuid())
  keyHash         String
  action          String
  windowStartedAt DateTime
  count           Int      @default(1)
  expiresAt       DateTime

  @@unique([keyHash, action, windowStartedAt])
  @@index([expiresAt])
}

model Notification {
  id            String              @id @default(cuid())
  userId        String
  type          String
  title         String
  body          String
  channel       NotificationChannel @default(IN_APP)
  status        NotificationStatus  @default(PENDING)
  dedupeKey     String?             @unique
  attemptCount  Int                 @default(0)
  lastErrorCode String?
  availableAt   DateTime            @default(now())
  sentAt        DateTime?
  readAt        DateTime?
  createdAt     DateTime            @default(now())
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([channel, status, availableAt])
}

model ModerationReport {
  id             String                 @id @default(cuid())
  reporterId     String
  reportedUserId String?
  reviewerId     String?
  contextType    String
  contextId      String
  messageId      String?
  reason         String
  detail         String?
  status         ModerationReportStatus @default(OPEN)
  resolution     String?
  reviewedAt     DateTime?
  createdAt      DateTime               @default(now())
  reporter       User                   @relation("ModerationReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User?                  @relation("ModerationReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reviewer       User?                  @relation("ModerationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedUserId, createdAt])
  @@index([contextType, contextId])
}

model AuditCheckpoint {
  id             String   @id @default(cuid())
  fromAt         DateTime
  throughAt      DateTime
  eventCount     Int
  previousDigest String?
  digest         String   @unique
  createdAt      DateTime @default(now())

  @@index([throughAt])
}
