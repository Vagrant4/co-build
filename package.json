    "ops:report": "tsx scripts/ops-report.ts",
    "ops:health-check": "tsx scripts/production-health-check.ts",
    "email:verify-provider": "tsx scripts/verify-email-provider.ts",
    "uploads:cleanup": "tsx scripts/cleanup-orphan-uploads.ts",
    "rate-limits:cleanup": "tsx scripts/cleanup-rate-limits.ts",
    "privacy:retention-report": "tsx scripts/retention-report.ts",
    "privacy:retention-execute": "tsx scripts/retention-execute.ts",
    "audit:checkpoint": "tsx scripts/audit-checkpoint.ts",
    "payments:reconcile": "tsx scripts/reconcile-bank-statement.ts",
    "pilot:preflight": "tsx scripts/pilot-preflight.ts",
    "vercel-build": "npm run prisma:generate:prod && npm run pilot:preflight && next build"
