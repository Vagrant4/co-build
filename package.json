    "csv-parse": "^6.1.0",
    "lucide-react": "latest",
    "next": "^16.2.12",
    "pdf-lib": "^1.17.1",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "0.35.3",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@playwright/test": "^1.62.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "10.4.20",
    "cross-env": "^10.1.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "latest",
