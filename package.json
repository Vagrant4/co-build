    "db:restore-drill": "tsx scripts/postgres-restore-drill.ts",
    "admin:bootstrap-first": "tsx scripts/bootstrap-first-admin.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:if-empty": "tsx prisma/seed-if-empty.ts",
