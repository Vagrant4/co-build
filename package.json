{
  "name": "fabrication-space-rental-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:generate:prod": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:push": "prisma db push",
    "db:push:prod": "prisma db push --schema prisma/schema.postgres.prisma",
    "db:deploy:prod": "prisma db push --schema prisma/schema.postgres.prisma --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:if-empty": "tsx prisma/seed-if-empty.ts",
    "test:auth": "vitest run tests/authorization*.test.ts tests/account-registration.test.ts tests/public-listing-eligibility.test.ts tests/clean-database.test.ts",
    "test:e2e": "playwright test",
    "vercel-build": "npm run db:deploy:prod && npm run prisma:generate:prod && next build"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.1",
    "@prisma/client": "6.19.3",
    "lucide-react": "latest",
    "next": "^16.2.11",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "10.4.20",
    "cross-env": "^10.1.0",
    "postcss": "8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2"
  }
}
