{
  "name": "fabrication-space-rental-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cross-env APP_MODE=demo next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:generate:prod": "prisma generate --schema prisma/postgres/schema.prisma",
    "db:push": "prisma db push",
    "db:deploy:prod": "prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:if-empty": "tsx prisma/seed-if-empty.ts",
    "test:auth": "vitest run tests/authorization*.test.ts tests/account-registration.test.ts tests/public-listing-eligibility.test.ts tests/clean-database.test.ts",
    "test:e2e": "playwright test",
    "ops:report": "tsx scripts/ops-report.ts",
    "uploads:cleanup": "tsx scripts/cleanup-orphan-uploads.ts",
    "vercel-build": "npm run prisma:generate:prod && next build"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.1",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "^2.6.1",
    "image-size": "^2.0.2",
    "lucide-react": "latest",
    "next": "^16.2.12",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "10.4.20",
    "cross-env": "^10.1.0",
    "postcss": "8.5.23",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "postcss": "8.5.23",
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  }
}
